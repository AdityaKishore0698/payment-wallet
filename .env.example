# Backend (FastAPI + Celery) environment variables.
# Copy to .env for local use, or set these in the Render dashboard when hosting.
# Docker Compose supplies its own values in docker-compose.yml.

# --- Database (Supabase) ---
# Use the "Transaction pooler" connection string (host ...pooler.supabase.com,
# port 6543). The plain postgresql:// scheme is upgraded to the async driver,
# and prepared statements are disabled automatically for the pooler.
DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Redis broker (Upstash) ---
# Upstash gives a TLS URL. Celery TLS is configured automatically for rediss://.
REDIS_URL=rediss://default:PASSWORD@your-db.upstash.io:6379

# --- CORS: comma-separated browser origins allowed to call the API ---
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional: regex for dynamic origins such as Vercel preview deploys.
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Google Sign-In ---
# OAuth 2.0 Client ID from Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → Web application.
# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly. Leave unset
# to disable Google sign-in (the button simply won't render).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
